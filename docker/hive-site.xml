<configuration>
  <!-- Thrift port for HiveServer2 -->
  <property>
    <name>hive.server2.thrift.port</name>
    <value>10000</value>
  </property>

  <!-- Bind host for HiveServer2 -->
  <property>
    <name>hive.server2.thrift.bind.host</name>
    <value>0.0.0.0</value>
  </property>

  <!-- Transport mode for HiveServer2 -->
  <property>
    <name>hive.server2.transport.mode</name>
    <value>binary</value>
  </property>

  <!-- Metastore URIs -->
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://hive-metastore:9083</value>
  </property>
</configuration>
